<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="mspr-flux-simple" name="Flux de données — Soutenance">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITRE -->
        <mxCell id="title" value="Pipeline Big Data — Electio-Analytics"
          style="text;fontStyle=1;fontSize=20;align=center;fillColor=none;strokeColor=none;"
          vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="769" height="40" as="geometry" />
        </mxCell>

        <!-- 1. SOURCES -->
        <mxCell id="src" value="📂 Sources de données&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Résultats électoraux (CSV)&lt;br/&gt;Population &amp; Revenu INSEE (CSV)&lt;br/&gt;Taux de chômage (XLSX)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- 2. ETL -->
        <mxCell id="etl" value="⚙️ ETL Python&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Nettoyage / Normalisation&lt;br/&gt;Calcul score_rn&lt;br/&gt;Chargement MySQL&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- 2b. Staging (simplifié, sous ETL) -->
        <mxCell id="stg" value="staging_*&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;zone d'atterrissage&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="390" y="205" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- 3. DWH -->
        <mxCell id="dwh" value="🗄️ Entrepôt de données&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Modèle en étoile MySQL&lt;br/&gt;dim_commune ⭐&lt;br/&gt;fact_election / revenu / pop / chômage&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="670" y="80" width="250" height="110" as="geometry" />
        </mxCell>

        <!-- 4. dataset_ml -->
        <mxCell id="dml" value="📊 dataset_ml&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Table finale historisée&lt;br/&gt;~35 000 communes × 5 années&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="670" y="270" width="250" height="90" as="geometry" />
        </mxCell>

        <!-- 5. ML -->
        <mxCell id="ml" value="🤖 Modèle Ridge ML&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Entraînement multi-années&lt;br/&gt;&lt;b&gt;R² = 0.61 &gt; 0.5 ✅&lt;/b&gt;&lt;br/&gt;Projection RN 2027 : 21.67 %&lt;/font&gt;"
          style="ellipse;whiteSpace=wrap;fillColor=#f0e6ff;strokeColor=#7a4fa3;fontStyle=1;fontSize=13;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="360" y="440" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- 6. API -->
        <mxCell id="api" value="🔌 API REST Flask&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;KPIs, Socio-éco, Prédiction&lt;br/&gt;Qualité données (/health)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="670" y="450" width="250" height="95" as="geometry" />
        </mxCell>

        <!-- 7. DASHBOARD -->
        <mxCell id="ui" value="🖥️ Dashboard&lt;br/&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Cartes, KPIs, Courbes&lt;br/&gt;Analyse socio-éco&lt;br/&gt;Projection 2027&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;arcSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="880" y="440" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- LÉGENDE RGPD -->
        <mxCell id="rgpd" value="🔒 Données publiques open data (Licence Ouverte) — Config via .env — SSL optionnel — RGPD : aucune donnée personnelle"
          style="text;fontStyle=2;fontSize=10;align=center;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="1060" height="30" as="geometry" />
        </mxCell>

        <!-- ═══ FLÈCHES ═══ -->

        <!-- Sources → ETL -->
        <mxCell id="a1" value="extract" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=2;fontSize=10;"
          edge="1" source="src" target="etl" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ETL → Staging -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=1;dashed=1;"
          edge="1" source="etl" target="stg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ETL → DWH -->
        <mxCell id="a3" value="load" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;fontStyle=2;fontSize=10;"
          edge="1" source="etl" target="dwh" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DWH → dataset_ml -->
        <mxCell id="a4" value="JOIN" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontStyle=2;fontSize=10;"
          edge="1" source="dwh" target="dml" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- dataset_ml → ML -->
        <mxCell id="a5" value="entraînement" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;fontStyle=2;fontSize=10;"
          edge="1" source="dml" target="ml" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- dataset_ml → API -->
        <mxCell id="a6" value="SQL" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;fontStyle=2;fontSize=10;"
          edge="1" source="dml" target="api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ML → API -->
        <mxCell id="a7" value=".joblib" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7a4fa3;strokeWidth=2;fontStyle=2;fontSize=10;"
          edge="1" source="ml" target="api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API → Dashboard -->
        <mxCell id="a8" value="JSON" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;fontStyle=2;fontSize=10;"
          edge="1" source="api" target="ui" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
